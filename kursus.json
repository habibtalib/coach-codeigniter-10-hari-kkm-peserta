      "label": "app.baseURL",
      "description": { "ms": "Tampal dalam .env sebagai app.baseURL (mesti berakhir dengan /).", "en": "Paste into .env as app.baseURL (must end with /)." },
      "env": "app.baseURL",
      "default": "http://localhost:8080/",
      "scope": "cohort",
      "days": [4, 5, 6, 7, 8, 9, 10]
    },
    {
      "key": "db_host",
