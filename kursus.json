      "env": "database.default.hostname",
      "default": "localhost",
      "scope": "cohort",
      "days": [4, 5, 6, 7, 8, 9, 10]
    },
    {
      "key": "db_name",
      "label": { "ms": "Nama DB", "en": "DB name" },
